# Cấu hình môi trường cho dịch vụ linhvuong-web trên Ubuntu Serve
# Sao chép tệp này vào /etc/linhvuong/env (chmod 600)

# Thư mục lưu gui_settings.json, auto_profile_*.json, vault.enc, logs/
LINHVUONG_DATA_DIR=/var/lib/linhvuong

# Địa chỉ lắng nghe (0.0.0.0 để truy cập từ ngoài VPS, hoặc 127.0.0.1 nếu đi qua SSH tunnel / Nginx)
LINHVUONG_WEB_HOST=0.0.0.0
LINHVUONG_WEB_PORT=8080

# Tài khoản & mật khẩu Phiên Quản Trị Web (nên đổi mật khẩu mạnh khi mở ra Internet)
LINHVUONG_WEB_USERNAME=admin
LINHVUONG_WEB_PASSWORD=admin

# Tùy chọn: Khóa chủ mở Két Mật Khẩu Mã Hóa (cho phép tự đăng nhập & chạy lại tác vụ sau reboot)
# Sinh khóa ngẫu nhiên: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# LINHVUONG_VAULT_KEY=
